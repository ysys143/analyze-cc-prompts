
# Native binary analysis artifacts (large extracted files, not tracked)
sources/native/
*.strings.txt
*_extracted.js
test_binary*

# npm package - large binaries (not needed for prompt analysis)
sources/npm/*/vendor/
sources/npm/*/node_modules/
sources/npm/*/*.wasm
sources/npm/*/.Rhistory
.DS_Store

# Common excludes
.env
.venv/
node_modules/

# Plugin/tool state files
.cwf/sessions/
.omc/sessions/
.omc/state/
tools/proxy/.cwf/sessions/
tools/proxy/.omc/state/
tools/proxy/dumps/
tools/proxy/.claude-home/
